# Copy to .env, change secrets; never put .env in git or share it.
POSTGRES_DB=wasl
POSTGRES_USER=wasl_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
APP_PORT=8080
# Secure default: only the host can reach the HTTP backend. Tailscale Serve proxies it over HTTPS.
BIND_IP=127.0.0.1
COOKIE_SECURE=true
# Optional: set after obtaining the exact HTTPS hostname, e.g. https://wasl-server.example.ts.net
PUBLIC_ORIGIN=
# Optional administrative thresholds in minutes; 0=disabled until approved by clinical governance.
SLA_MINUTES_ROUTINE=0
SLA_MINUTES_URGENT=0
SLA_MINUTES_EMERGENCY=0

# Hospital operating day begins at 09:00 local hospital time.
CLINICAL_TIMEZONE=Asia/Damascus
